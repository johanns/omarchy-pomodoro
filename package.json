{
	"name": "jg.pomodoro",
	"version": "1.0.0",
	"description": "Pomodoro for the Omarchy shell",
	"homepage": "https://github.com/johanns/omarchy-pomodoro#readme",
	"bugs": {
		"url": "https://github.com/johanns/omarchy-pomodoro/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johanns/omarchy-pomodoro.git"
	},
	"license": "MIT",
	"author": "Johanns Gregorian",
	"type": "commonjs",
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"scripts": {
		"formatL:js": "biome format --write",
		"lint:js": "biome lint --write",
		"test": "node Model.test.js",
		"format:qml": "/usr/lib/qt6/bin/qmlformat --inplace *.qml",
		"lint:qml": "mkdir -p .qml-imports && ln -sfn /usr/share/omarchy/shell .qml-imports/qs && /usr/lib/qt6/bin/qmllint -I .qml-imports *.qml"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6"
	}
}
